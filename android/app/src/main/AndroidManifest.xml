<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 8–11: Bluetooth і пошук Bluetooth LE (пошук там вимагає дозволу на місцезнаходження). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />
    <!-- Android 12+: «Пристрої поблизу». Місцезнаходження з пошуку не виводимо (neverForLocation). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- T37: інтернет — ЛИШЕ для оновлення застосунку з Google Диска автора (прочитати файл версії й APK; телефон
         автора — ще й перевірити, що опублікована версія дійшла). Дані батареї нікуди не йдуть. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- T37: відкрити вікно Android «Оновити» для перевіреного APK. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Запис у фоні (v0.2.5): служба з тихим сповіщенням, будильник раз на 5 хв, перезапуск після увімкнення
         телефона й оновлення застосунку; короткий «не спати» лише на час одного читання. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:name=".AolithiumApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Aolithium Live"
        android:supportsRtl="true"
        android:theme="@style/Theme.AolithiumLive">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- T63 (v0.4.17): значок на вибір. Вхід у список застосунків — не саме вікно, а чотири псевдоніми з різними
             значками; увімкнений лише один (вибір — «Ще» → «Значок застосунку», core/AppIcon.kt). MainActivity лишається
             exported — його відкривають віджети, сповіщення й знімки CI (am start -n …/.ui.MainActivity). -->
        <activity-alias
            android:name="ua.faric.aolithium.IconClassic"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="Aolithium Live"
            android:targetActivity=".ui.MainActivity">
            <!-- А — батарея з блискавкою (як до 0.4.17), увімкнений з коробки -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="ua.faric.aolithium.IconRing"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ring"
            android:roundIcon="@mipmap/ic_launcher_ring"
            android:label="Aolithium Live"
            android:targetActivity=".ui.MainActivity">
            <!-- Б — кільце заряду -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="ua.faric.aolithium.IconLevel"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_level"
            android:roundIcon="@mipmap/ic_launcher_level"
            android:label="Aolithium Live"
            android:targetActivity=".ui.MainActivity">
            <!-- В — рівень заряду -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="ua.faric.aolithium.IconPulse"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pulse"
            android:roundIcon="@mipmap/ic_launcher_pulse"
            android:label="Aolithium Live"
            android:targetActivity=".ui.MainActivity">
            <!-- Г — батарея з пульсом -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- T37: перевірений APK оновлення (cache/updates/) — вікну встановлення Android. Свій провайдер замість
             androidx FileProvider (бібліотек у застосунку нема): лише читання, лише цей файл. -->
        <provider
            android:name=".update.UpdateApkProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true" />

        <service
            android:name=".bg.RecordService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name=".bg.BgReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- T22 (v0.4.16): «Яку батарею показувати?» — Android відкриває під час додавання віджета й за «налаштувати
             віджет» (Android 12+). exported — бо відкриває домашній екран; чужі номери віджетів вікно відкидає. -->
        <activity
            android:name=".widget.WidgetSetupActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AolithiumLive">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Віджети на головний екран (v0.3.1): великий 4 × 2 і малий 2 × 2. -->
        <receiver
            android:name=".widget.WidgetLarge"
            android:exported="true"
            android:label="Aolithium · великий">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_large" />
        </receiver>

        <receiver
            android:name=".widget.WidgetSmall"
            android:exported="true"
            android:label="Aolithium · малий">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_small" />
        </receiver>
    </application>
</manifest>
